@page
@model GameModel
@{ ViewData["Title"] = "Winter Maze"; }
<div class="game-page" id="mazeApp" data-session-id="@Model.SessionId" data-player-name="@Model.PlayerName"><div class="game-heading"><div><div class="eyebrow"><span class="eyebrow-dot"></span> CO-OP MISSION / LEVEL 01</div><h1>Winter <span>Maze</span></h1><p>Find the hidden symbol. Keep the exit secret until your teammate activates it.</p></div><div class="session-chip"><small>SESSION</small><b>@Model.SessionId</b><span><i></i> @(Model.DemoMode ? "Demo mode" : "Live API mode")</span></div></div><div class="game-layout"><section class="maze-card"><div class="maze-toolbar"><div><span class="section-kicker">YOUR MAP</span><h2>Snowbound passage</h2></div><span class="level-badge">❄ LEVEL 1</span></div><p class="maze-instructions">Use the arrow keys or controls to move. Find the hidden checkpoint; the exit stays locked until the Unity player activates it.</p><div class="maze-wrap"><div id="mazeGrid" class="maze-grid" role="grid" aria-label="Interactive winter maze"></div></div><div class="maze-legend"><span><i class="legend-player"></i> You</span><span><i class="legend-checkpoint"></i> Hidden symbol</span><span><i class="legend-exit"></i> Exit (locked)</span></div></section><aside class="side-column"><section class="info-card"><span class="section-kicker">MISSION STATUS</span><div class="mission-status"><span>◉</span><div><h2 id="missionStatus">Explore the maze</h2><p id="missionDetail">Find the hidden checkpoint.</p></div></div><div class="progress-track"><span id="progressBar"></span></div><div class="progress-label"><span>Mission progress</span><b id="progressText">0%</b></div></section><section class="info-card controls-card"><span class="section-kicker">MOVEMENT</span><h2>Navigate</h2><div class="dpad"><span></span><button type="button" data-move="up" aria-label="Move up">↑</button><span></span><button type="button" data-move="left" aria-label="Move left">←</button><button type="button" data-move="down" aria-label="Move down">↓</button><button type="button" data-move="right" aria-label="Move right">→</button></div><p class="keyboard-note">Keyboard: arrows or WASD</p></section><section class="info-card clue-card"><span class="section-kicker">TEAM COMMUNICATION</span><h2>Share your clue</h2><p id="clueText">Reach the checkpoint to reveal the symbol.</p><div id="symbolPanel" class="symbol-panel hidden"><span>DISCOVERED SYMBOL</span><strong id="symbolValue">❄ SNOWFLAKE</strong></div><button id="sendSymbolButton" class="primary-button" type="button" disabled>Send symbol to Unity <span>→</span></button>@if (Model.DemoMode)
            {
                <button id="demoUnlockButton" class="secondary-button hidden" type="button">Demo: simulate Unity activation</button>
            }</section></aside></div><section class="activity-card"><div class="activity-heading"><div><span class="section-kicker">LIVE LOG</span><h2>Mission activity</h2></div><span class="live-badge"><i></i> @(Model.DemoMode ? "LOCAL DEMO" : "LIVE API")</span></div><div id="activityLog" aria-live="polite"><p class="activity-entry">Welcome, @Model.PlayerName. Find the hidden symbol to begin.</p></div></section><div id="toast" class="toast" role="status"></div></div>
@section Scripts { <script src="~/js/maze.js" asp-append-version="true"></script> }
