@page
@model IndexModel
@{ ViewData["Title"] = "Join the Escape Room"; }
<section class="landing"><div class="hero-copy"><div class="eyebrow"><span class="eyebrow-dot"></span> TWO PLAYERS. ONE ESCAPE.</div><h1>Every clue matters.<br/><span>Every player counts.</span></h1><p class="hero-description">Your teammate is inside the winter escape room. You hold the clues they can’t see. Work together, uncover the hidden symbol, and unlock the way out.</p><div class="feature-row"><div class="feature"><span class="feature-icon">⌘</span><div><b>Play together</b><small>Coordinate with your teammate</small></div></div><div class="feature"><span class="feature-icon">❄</span><div><b>Discover clues</b><small>Explore the winter maze</small></div></div></div></div><div class="join-card"><div class="card-topline"><span class="card-icon">↗</span><span class="status-pill"><i></i> READY TO CONNECT</span></div><h2>Join your session</h2><p class="card-subtitle">Enter the details shared by your teammate.</p>@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="error-message" role="alert">@Model.ErrorMessage</div>}<form method="post"><label asp-for="SessionCode">SESSION CODE</label><input asp-for="SessionCode" placeholder="e.g. WINTER-204" autocomplete="off" required/><label asp-for="PlayerName">YOUR PLAYER NAME</label><input asp-for="PlayerName" placeholder="Enter your name" autocomplete="name" required/><button class="primary-button" type="submit">Join escape room <span>→</span></button></form><div class="secure-note">✦ Your session connects you to a shared puzzle experience.</div></div></section><section id="how-it-works" class="how-section"><div><span class="section-kicker">THE MISSION</span><h2>Two perspectives. One solution.</h2></div><div class="steps"><article><span>01</span><h3>Join the session</h3><p>Use the session code from your teammate.</p></article><article><span>02</span><h3>Explore the maze</h3><p>Move through the snow-covered passages and find the hidden symbol.</p></article><article><span>03</span><h3>Share the clue</h3><p>Tell the Unity player the symbol to activate the mechanism.</p></article></div></section>
