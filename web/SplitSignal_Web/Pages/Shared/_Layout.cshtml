<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>@ViewData["Title"] - Collaborative Escape Room</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">
            <span class="brand-icon">❄</span>
            <span>COLLABORATIVE <b>ESCAPE ROOM</b></span>
        </a>

        <nav>
            <a asp-page="/Index">Home</a>
        </nav>

        <span class="header-tag">WEB COMPANION</span>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>© 2026 Collaborative Escape Room</span>
        <span>Built for cooperative play · Reggie’s web companion</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    <!--
        This is necessary for SignalR, please do not remove.
    -->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/APIClient.js" ></script>
    <!--
        End necessary for SignalR.
    -->

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
