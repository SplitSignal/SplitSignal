@page
@model GameModel

<div class="game-page" id="mazeApp">
    <div class="game-heading">
        <div class="game-title-group">
            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                CO-OP MISSION / WEB PLAYER
            </div>
            <h1 id="gameStageHeading">Winter <span>Maze</span></h1>
            <p id="gameStageDescription">Find the three symbols. Unity must collect them before the exit opens.</p>
        </div>

        <div class="session-chip">
            <small>SESSION</small>
            <b class="session-Code"></b>
            <span class="demoMode-Display" hidden>Demo mode</span>
            <span class="liveMode-Display" hidden>Live API mode</span>
        </div>
    </div>

    <div class="game-stage-progress" role="list" aria-label="Game progress">
        <div class="stage-step is-current" data-step="maze" role="listitem" aria-current="step">
            <span class="stage-step-number">01</span><span>Maze</span>
        </div>
        <div class="stage-step" data-step="cipher" role="listitem">
            <span class="stage-step-number">02</span><span>Cipher</span>
        </div>
        <div class="stage-step" data-step="ice" role="listitem">
            <span class="stage-step-number">03</span><span>Ice diagram</span>
        </div>
    </div>

    <div class="game-stage-viewport" id="coopPuzzleConsole">
        <!-- Stage 1: Maze and Unity symbol acknowledgments -->
        <section class="game-stage stage-maze" id="stage-maze" aria-label="Maze puzzle">
            <div class="game-layout">
                <section class="maze-card">
                    <div class="maze-toolbar">
                        <div>
                            <span class="section-kicker">PUZZLE 1 · YOUR MAP</span>
                            <h2>Snowbound passage</h2>
                        </div>
                        <span class="level-badge">❄ LEVEL 1</span>
                    </div>
                    <p class="maze-instructions">
                        Use the arrow keys or controls to move. Discover all three symbols and wait for
                        your Unity partner to collect them. Then reach the exit.
                    </p>
                    <div class="maze-wrap">
                        <div id="mazeGrid" class="maze-grid" role="grid" aria-label="Interactive winter maze"></div>
                    </div>
                    <div class="maze-legend">
                        <span><i class="legend-player"></i> You</span>
                        <span><i class="legend-checkpoint"></i> Found symbol</span>
                        <span><i class="legend-exit"></i> Exit when unlocked</span>
                    </div>
                </section>

                <aside class="side-column">
                    <section class="info-card">
                        <span class="section-kicker">MISSION STATUS & SYMBOLS</span>
                        <div class="mission-status">
                            <span>◉</span>
                            <div>
                                <h2 id="missionStatus">Explore the maze</h2>
                                <p id="missionDetail">Find the three hidden symbols.</p>
                            </div>
                        </div>
                        <div class="progress-track"><span id="progressBar"></span></div>
                        <div class="progress-label"><span>Mission progress</span><b id="progressText">0%</b></div>
                        <!-- maze.js inserts the discovered-symbol status here. -->
                    </section>

                    <section class="info-card controls-card">
                        <span class="section-kicker">MOVEMENT</span>
                        <h2>Navigate</h2>
                        <div class="dpad">
                            <span></span>
                            <button type="button" data-move="up" aria-label="Move up">↑</button>
                            <span></span>
                            <button type="button" data-move="left" aria-label="Move left">←</button>
                            <button type="button" data-move="down" aria-label="Move down">↓</button>
                            <button type="button" data-move="right" aria-label="Move right">→</button>
                        </div>
                        <p class="keyboard-note">Keyboard: arrows or WASD</p>
                    </section>

                    <section class="info-card clue-card">
                        <span class="section-kicker">TEAM COMMUNICATION</span>
                        <h2>Coordinate with Unity</h2>
                        <p id="clueText">Find each symbol; then your partner must collect all three.</p>
                        <button id="demoUnlockButton" class="secondary-button hidden"
                                type="button" hidden>
                            Demo: simulate Unity collecting symbols
                        </button>
                    </section>
                </aside>
            </div>
        </section>

        <!-- Stage 2: Becomes available only after maze.js confirms the exit reached / cage open sent. -->
        <section class="game-stage stage-cipher" id="stage-cipher" aria-label="Cipher puzzle" hidden>
            <div class="puzzle-console">
                <div class="puzzle-heading">
                    <div>
                        <span class="section-kicker">PUZZLE 2 · CODE WORD</span>
                        <h2>Decode the mountain instrument</h2>
                        <p>Your Unity partner can reveal the method. Ask them to find the clue.</p>
                    </div>
                    <span class="level-badge">CIPHER</span>
                </div>
                <div class="puzzle-stage" id="decodeStage">
                    <div>
                        <span class="section-kicker">ENCRYPTED MESSAGE</span>
                        <h3>What is the hidden word?</h3>
                        <p>The encoded word is <strong id="cipherText">EZIRLNVGVI</strong>.</p>
                    </div>
                    <form id="decodeForm" class="decode-form">
                        <label for="decodedWord">Decoded word</label>
                        <input id="decodedWord" name="decodedWord" autocomplete="off"
                               maxlength="20" placeholder="Enter the decoded word" required>
                        <button class="primary-button" type="submit">Submit decoded word <span>→</span></button>
                        <p id="decodeFeedback" class="puzzle-feedback" aria-live="polite">
                            Reach the maze exit to unlock this puzzle.
                        </p>
                    </form>
                </div>
            </div>
        </section>

        <!-- Stage 3: The script unlocks its puzzle only after cipher completion and iceDiagram/Found. -->
        <section class="game-stage stage-ice" id="stage-ice" aria-label="Ice diagram puzzle" hidden>
            <div class="puzzle-console">
                <div class="puzzle-heading">
                    <div>
                        <span class="section-kicker">FROZEN IMAGE</span>
                        <h2>Build the diagram</h2>
                        <p>Follow the pedestal shadow. Try to keep it cool.</p>
                    </div>
                    <span class="level-badge">FINAL PUZZLE</span>
                </div>
                <div class="puzzle-stage">
                    <div>
                        <span class="section-kicker">ICE MECHANISM</span>
                        <h3>Place the frozen blocks</h3>
                        <p>
                            Each placed block melts after five seconds. Your Unity teammate can pause the
                            timers by entering the ice pond.
                        </p>
                    </div>
                    <div class="cube-panel">
                        <div class="cube-toolbar">
                            <span id="cubeStatus">0 / 20 blocks placed</span>
                            <span id="icePondStatus" class="ice-pond-status is-inactive">Ice pond inactive</span>
                            <input type="checkbox" id="freezeCubes" hidden aria-hidden="true" tabindex="-1">
                        </div>
                        <div id="cubeGrid" class="cube-grid" aria-label="Frozen pedestal puzzle"></div>
                        <p id="cubeFeedback" class="puzzle-feedback" aria-live="polite">
                            Waiting for Unity to discover the ice diagram.
                        </p>
                        <button id="resetCubes" type="button" class="secondary-button">Reset cube image</button>
                    </div>
                </div>
                <!-- Retained for the original puzzle script's retry and status functionality. -->
                <div class="puzzle-stage final-stage" hidden>
                    <div>
                        <span class="section-kicker">ESCAPE SEQUENCE</span>
                        <h3>Pedestal drop</h3>
                        <p>Completing the correct diagram notifies Unity to drop the pedestal.</p>
                    </div>
                    <div class="sequence-actions">
                        <button id="cageButton" type="button" class="primary-button" disabled hidden>
                            Interact with caged button
                        </button>
                        <button id="pedestalButton" type="button" class="secondary-button" disabled>
                            Retry pedestal drop
                        </button>
                        <p id="sequenceFeedback" class="puzzle-feedback" aria-live="polite"></p>
                    </div>
                </div>
            </div>
        </section>

        <section class="game-stage stage-complete" id="stage-complete" aria-label="Game completed" hidden>
            <div class="completion-card">
                <div class="completion-icon" aria-hidden="true">❄</div>
                <span class="section-kicker">COOPERATIVE MISSION COMPLETE</span>
                <h2>Signal sent.</h2>
                <p>
                    You completed the pedestal diagram and sent the drop request to Unity.
                    Your teammate can now finish the escape sequence.
                </p>
                <p class="completion-note">You can remain here while Unity completes the final step.</p>
            </div>
        </section>
    </div>

    <!-- Collapsed by default so the game stays within the browser viewport. -->
    <details class="activity-card game-activity">
        <summary>
            <span><span class="live-indicator" aria-hidden="true"></span> Mission activity</span>
            <span class="activity-mode demoMode-Display" hidden>Demo mode</span>
            <span class="activity-mode liveMode-Display" hidden>Live API mode</span>
            <span class="activity-view-label">View log</span>
        </summary>
        <div id="activityLog" class="game-log-scroll" aria-live="polite">
            <p class="activity-entry">Welcome. Find the hidden symbols to begin.</p>
        </div>
    </details>

    <div id="toast" class="toast" role="status"></div>
</div>

@section Scripts {
    <script>
        // Keep the existing APIClient.js connection implementation unchanged.
        // Update visible session information without waiting for the network reconnect.
        const storedSessionCode = sessionStorage.getItem("sessionCode");
        const gameDemoMode = sessionStorage.getItem("demoMode") === "true";
        if (!storedSessionCode) {
            window.location.replace("/Index");
        } else {
            document.querySelectorAll(".session-Code").forEach(element => {
                element.textContent = storedSessionCode;
            });
            document.querySelectorAll(".demoMode-Display").forEach(element => {
                element.hidden = !gameDemoMode;
            });
            document.querySelectorAll(".liveMode-Display").forEach(element => {
                element.hidden = gameDemoMode;
            });
            void reconnectSession();
        }
    </script>
    <script src="~/js/game-stages.js" asp-append-version="true"></script>
    <script type="module" src="~/js/maze.js" asp-append-version="true"></script>
    <script type="module" src="~/js/coop-puzzles.js" asp-append-version="true"></script>
}
