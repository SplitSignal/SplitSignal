@page
@model GameModel

<head>
    <script>
        const sessionCode = sessionStorage.getItem("sessionCode");
        const demoMode = sessionStorage.getItem("demoMode") === "true";

        console.log(`In the game window. Session code: ${sessionCode}.`);
        console.log(`Demo Status: ${demoMode}.`)

        // Redirect if no session code exists
        if (!sessionCode) {
            console.log("Exiting the game window. No session code.");
            window.location.replace("/Index");
        }
        else {
            document.addEventListener("DOMContentLoaded", async () => {

                // Reconnect to the game session
                await reconnectSession();

                // Display session code
                document.querySelectorAll(".session-Code").forEach(element => {
                    element.textContent = sessionCode;
                });

                // Display appropriate mode
                document.querySelectorAll(".demoMode-Display").forEach(element => {
                    element.hidden = !demoMode;
                });

                document.querySelectorAll(".liveMode-Display").forEach(element => {
                    element.hidden = demoMode;
                });

                document.querySelectorAll(".mountainSignals").forEach(element => {
                    element.hidden = !demoMode;
                });

                document.getElementById("sendSymbolButton").hidden = !demoMode;

            });
        }
    </script>
</head>


<div class="game-page"
     id="mazeApp">

    <div class="game-heading">
        <div>
            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                CO-OP MISSION / LEVEL 01
            </div>

            <h1>Winter <span>Maze</span></h1>

            <p>
                Find the hidden symbol. Keep the exit secret until your teammate activates it.
            </p>
        </div>

        <div class="session-chip">
            <small>SESSION</small>
            <b class="session-Code"></b>
            <span class="demoMode-Display" hidden>
                Demo mode
            </span>
            <span class="liveMode-Display" hidden>
                Live API mode
            </span>
        </div>
    </div>

    <div class="game-layout">
        <section class="maze-card">
            <div class="maze-toolbar">
                <div>
                    <span class="section-kicker">YOUR MAP</span>
                    <h2>Snowbound passage</h2>
                </div>

                <span class="level-badge">❄ LEVEL 1</span>
            </div>

            <p class="maze-instructions">
                Use the arrow keys or controls to move. Find the hidden checkpoint;
                the exit stays locked until the Unity player activates it.
            </p>

            <div class="maze-wrap">
                <div id="mazeGrid"
                     class="maze-grid"
                     role="grid"
                     aria-label="Interactive winter maze">
                </div>
            </div>

            <div class="maze-legend">
                <span><i class="legend-player"></i> You</span>
                <span><i class="legend-checkpoint"></i> Hidden symbol</span>
                <span><i class="legend-exit"></i> Exit (locked)</span>
            </div>
        </section>

        <aside class="side-column">
            <section class="info-card">
                <span class="section-kicker">MISSION STATUS</span>

                <div class="mission-status">
                    <span>◉</span>
                    <div>
                        <h2 id="missionStatus">Explore the maze</h2>
                        <p id="missionDetail">Find the hidden checkpoint.</p>
                    </div>
                </div>

                <div class="progress-track">
                    <span id="progressBar"></span>
                </div>

                <div class="progress-label">
                    <span>Mission progress</span>
                    <b id="progressText">0%</b>
                </div>
            </section>

            <section class="info-card controls-card">
                <span class="section-kicker">MOVEMENT</span>
                <h2>Navigate</h2>

                <div class="dpad">
                    <span></span>
                    <button type="button" data-move="up" aria-label="Move up">↑</button>
                    <span></span>
                    <button type="button" data-move="left" aria-label="Move left">←</button>
                    <button type="button" data-move="down" aria-label="Move down">↓</button>
                    <button type="button" data-move="right" aria-label="Move right">→</button>
                </div>

                <p class="keyboard-note">Keyboard: arrows or WASD</p>
            </section>

            <section class="info-card clue-card">
                <span class="section-kicker">TEAM COMMUNICATION</span>
                <h2>Share your clue</h2>

                <p id="clueText">
                    Reach the checkpoint to reveal the symbol.
                </p>

                <div id="symbolPanel" class="symbol-panel hidden">
                    <span>DISCOVERED SYMBOL</span>
                    <strong id="symbolValue">❄ SNOWFLAKE</strong>
                </div>

                <button id="sendSymbolButton"
                        class="primary-button"
                        type="button"
                        disabled
                        hidden>
                    Send symbol to Unity <span>→</span>
                </button>

                
                <button id="demoUnlockButton"
                        class="secondary-button hidden demoMode-Display"
                        type="button">
                    Demo: simulate Unity activation
                </button>
                
            </section>
        </aside>
    </div>

    <section class="puzzle-console"
             id="coopPuzzleConsole"
             aria-labelledby="coopPuzzleTitle">

        <div class="puzzle-heading mountainSignals" hidden>
            <div>
                <span class="section-kicker">CO-OP PUZZLES</span>
                <h2 id="coopPuzzleTitle">The mountain signals</h2>

                <p>
                    Discover the same symbols in the maze and Unity scene,
                    decode the clue, then solve the frozen-cube image together.
                </p>
            </div>

            <span class="level-badge">3 STAGES</span>
        </div>

        <div class="symbol-grid mountainSignals" hidden>
            <article class="symbol-tile">
                <div class="symbol-art snowflake-art" aria-hidden="true">❄</div>
                <h3>Snowflake</h3>
                <p>Found in the maze</p>

                <button type="button"
                        class="secondary-button symbol-find"
                        data-symbol="SNOWFLAKE">
                    Find snowflake
                </button>
            </article>

            <article class="symbol-tile">
                <div class="symbol-art tree-art" aria-hidden="true">♠</div>
                <h3>Tree</h3>
                <p>Hidden in the maze</p>

                <button type="button"
                        class="secondary-button symbol-find"
                        data-symbol="TREE">
                    Find tree
                </button>
            </article>

            <article class="symbol-tile">
                <div class="symbol-art candle-art" aria-hidden="true">🕯</div>
                <h3>Candle</h3>
                <p>Hidden in the maze</p>

                <button type="button"
                        class="secondary-button symbol-find"
                        data-symbol="CANDLE">
                    Find candle
                </button>
            </article>
        </div>

        <div class="puzzle-stage" id="decodeStage">
            <div>
                <span class="section-kicker">PUZZLE 2 · ATBASH CIPHER</span>
                <h3>Decode the mountain instrument</h3>

                <p>
                    Use Atbash (A↔Z, B↔Y, C↔X).
                    The clue is <strong id="cipherText">EZIRLNVGVI</strong>.
                </p>
            </div>

            <form id="decodeForm" class="decode-form">
                <label for="decodedWord">Decoded word</label>

                <input id="decodedWord"
                       name="decodedWord"
                       autocomplete="off"
                       maxlength="20"
                       placeholder="Enter the decoded word"
                       required>

                <button class="primary-button" type="submit">
                    Submit decoded word <span>→</span>
                </button>

                <p id="decodeFeedback"
                   class="puzzle-feedback"
                   aria-live="polite">
                    Find all three symbols to open this stage.
                </p>
            </form>
        </div>

        <div class="puzzle-stage">
            <div>
                <span class="section-kicker">PUZZLE 3 · FROZEN IMAGE</span>
                <h3>Build the 20-cube image</h3>

                <p>
                    Each cube melts after five seconds. The Unity player must
                    stand in the frozen lake to pause all timers. For local
                    testing, use the freeze toggle below.
                </p>
            </div>

            <div class="cube-panel">
                <div class="cube-toolbar">
                    <span id="cubeStatus">0 / 20 cubes placed</span>

                    <label class="freeze-toggle">
                        <input type="checkbox" id="freezeCubes">
                        Frozen lake active
                    </label>
                </div>

                <div id="cubeGrid"
                     class="cube-grid"
                     aria-label="20 cube puzzle">
                </div>

                <p id="cubeFeedback"
                   class="puzzle-feedback"
                   aria-live="polite">
                    Complete the Atbash clue first.
                </p>

                <button id="resetCubes"
                        type="button"
                        class="secondary-button">
                    Reset cube image
                </button>
            </div>
        </div>

        <div class="puzzle-stage final-stage">
            <div>
                <span class="section-kicker">ESCAPE SEQUENCE</span>
                <h3>Button, paraglider, pedestal</h3>

                <p>
                    The cage button is available after Puzzle 1. After decoding,
                    click it to signal the Unity player; completing the cube
                    image signals the pedestal drop / escape sequence.
                </p>
            </div>

            <div class="sequence-actions">
                <button id="cageButton"
                        type="button"
                        class="primary-button"
                        disabled>
                    Interact with caged button <span>→</span>
                </button>

                <button id="pedestalButton"
                        type="button"
                        class="secondary-button"
                        disabled>
                    Complete escape sequence
                </button>

                <p id="sequenceFeedback"
                   class="puzzle-feedback"
                   aria-live="polite">
                    Discover the three symbols to unlock the cage.
                </p>
            </div>
        </div>
    </section>

    <section class="activity-card">
        <div class="activity-heading">
            <div>
                <span class="section-kicker">LIVE LOG</span>
                <h2>Mission activity</h2>
            </div>

            <span class="live-badge">
                <i></i>
                <span class="demoMode-Display" hidden>
                    Demo mode
                </span>
                <span class="liveMode-Display" hidden>
                    Live API mode
                </span>
            </span>
        </div>

        <div id="activityLog" aria-live="polite">
            <p class="activity-entry">
                Welcome, find the hidden symbol to begin.
            </p>
        </div>
    </section>

    <div id="toast" class="toast" role="status"></div>
</div>

@section Scripts {
    <script type="module" src="~/js/maze.js" asp-append-version="true"></script>
    <script type="module" src="~/js/coop-puzzles.js" asp-append-version="true"></script>
}
