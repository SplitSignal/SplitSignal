# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
*.swp

# Secrets / local config — never commit these
.env
.env.local
*.local.json

# Node (web/ and server/ if you use JS)
node_modules/
npm-debug.log*
yarn-error.log*

# Python (server/ if you use Python)
__pycache__/
*.py[cod]
.venv/
venv/

# Local databases
*.sqlite
*.sqlite3
*.db

/Assets/
/Packages/
/ProjectSettings/
/Library/
/Temp/
/Logs/
/UserSettings/
